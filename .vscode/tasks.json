{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure & Build", // Name matches the configure and build action.
            "type": "shell",
            "windows": {
                // PowerShell command that configures CMake and then builds with cmake --build.
                "command": "$env:Path = 'C:\\TDM-GCC-64\\bin;' + $env:Path; if (!(Test-Path -Path '${workspaceFolder}/build')) { New-Item -Path '${workspaceFolder}/build' -ItemType Directory }; Set-Location -Path '${workspaceFolder}/build'; cmake -G 'MinGW Makefiles' -DCMAKE_C_COMPILER='C:/TDM-GCC-64/bin/gcc.exe' -DCMAKE_CXX_COMPILER='C:/TDM-GCC-64/bin/g++.exe' ..; if ($?) { cmake --build . }"
            },
            "linux": {
                // Configure and build with the default CMake generator.
                "command": "mkdir -p '${workspaceFolder}/build/' && cd '${workspaceFolder}/build/' && cmake .. && cmake --build ."
            },
            "osx": {
                 // Configure and build with the default CMake generator.
                "command": "mkdir -p '${workspaceFolder}/build/' && cd '${workspaceFolder}/build/' && cmake .. && cmake --build ."
            },
            "options": {
                // Keep relative paths such as 'build' and '..' rooted at the workspace.
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true // Default build task used by Ctrl+Shift+B.
            },
            "problemMatcher": [
                "$gcc" // GCC problem matcher.
            ]
        },
        {
            "label": "Clean",
            "type": "shell",
            "windows": {
                 // PowerShell clean command.
                "command": "if (Test-Path -Path '${workspaceFolder}/build') { Remove-Item -Path '${workspaceFolder}/build' -Recurse -Force }"
            },
            "linux": {
                // Remove the non-empty build directory.
                "command": "rm -rf '${workspaceFolder}/build'"
            },
            "osx": {
                 // Remove the non-empty build directory.
                "command": "rm -rf '${workspaceFolder}/build'"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
